  "examples": {
    "direct_paragraph_formatting": [
      {
        "para_index": 1,
        "text": "\u8003\u8651\u7269\u6027\u53d8\u5316\u4e0e\u5f84\u5411\u6536\u7f29\u7684\u836f\u6750\u70ed\u6e7f\u8026\u5408\u6a21\u578b\u53ca\u6570\u503c\u9a8c\u8bc1",
