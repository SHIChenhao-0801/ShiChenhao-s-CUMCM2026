      {
        "para_index": 2,
        "text": "\u6458\u8981",
        "style": "Heading 2"
      },
      {
        "para_index": 3,
        "text": "\u836f\u6750\u70ed\u98ce\u70d8\u5e72\u540c\u65f6\u6d89\u53ca\u6e29\u5ea6\u4f20\u9012\u3001\u6c34\u5206\u8fc1\u79fb\u53ca\u5c3a\u5bf8\u53d8\u5316\uff0c\u8868\u9762\u72b6\u6001\u96be\u4ee5\u76f4\u63a5\u4ee3\u8868\u5185\u90e8\u5e72\u71e5\u7a0b\u5ea6\u3002\u9488\u5bf9\u5706\u67f1\u5f62\u836f\u6750\u7684\u56db\u4e2a\u95ee\u9898\uff0c\u672c\u6587\u57fa\u4e8e\u9898\u7ed9\u73af\u5883\u89c2\u6d4b\u548c\u7269\u6027\u5173\u7cfb\uff0c\u5efa\u7acb\u4e00\u7ef4\u5f84\u5411\u6709\u6548\u70ed\u6e7f\u8026\u5408\u6a21\u578b\uff0c\u5e76\u4ee5\u5168\u57df\u6700\u5927\u5e72\u57fa\u542b\u6c34\u7387\u786e\u5b9a\u70d8\u5e72\u7ed3\u675f\u65f6\u95f4\u3002\u6a21\u578b\u533a\u5206\u6709\u6548\u663e\u70ed\u5bb9\u91cf\u4e0e\u5b88\u6052\u5e72",
        "style": "Normal"
      },
      {
        "para_index": 4,
        "text": "\u9488\u5bf9\u95ee\u9898\u4e00\uff0c\u91c7\u7528\u5e38\u70ed\u7269\u6027\u4e0e\u542b\u6c34\u7387\u4f9d\u8d56\u6269\u6563\u7cfb\u6570\u5efa\u7acb\u9884\u70ed\u6a21\u578b\uff0c\u8ba1\u7b970\u20141800 s\u5185\u6e29\u5ea6\u548c\u6c34\u5206\u7684\u5f84\u5411\u5206\u5e03\u30021800 s\u65f6\u4e2d\u5fc3\u3001\u8868\u9762\u6e29\u5ea6\u5206\u522b\u4e3a33.5753\u00b0C\u548c36.7856\u00b0C\uff0c\u5e72\u57fa\u542b\u6c34\u7387\u5206\u522b\u663e\u793a2.5500\u548c1.5102 kg/kg\uff0c\u53cd\u6620\u8868",
        "style": "Normal"
      },
      {
        "para_index": 5,
        "text": "\u9488\u5bf9\u95ee\u9898\u4e8c\uff0c\u4ece\u521d\u59cb\u72b6\u6001\u7edf\u4e00\u91c7\u7528\u9644\u5f553\u7684\u53d8\u7269\u6027\uff0c\u8054\u7acb\u8ba1\u7b97\u6e29\u5ea6\u5bf9\u6269\u6563\u53ca\u6c34\u5206\u5bf9\u70ed\u7269\u6027\u7684\u53cd\u9988\u3002\u9644\u4ef6\u89c2\u6d4b\u533a\u95f4\u5185\u8fdb\u884c\u5206\u6bb5\u7ebf\u6027\u63d2\u503c\uff0c4 h\u540e\u630950\u00b0C\u4e0e\u7b49\u6548\u5e73\u8861\u542b\u6c34\u73870.05\u5ef6\u62d3\u30023 h\u65f6\u4e2d\u5fc3\u3001\u8868\u9762\u6e29\u5ea6\u4e3a49.8495\u00b0C\u548c49.9664\u00b0C\uff0c\u800c\u542b\u6c34\u7387\u4ecd",
